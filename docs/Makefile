# Makefile for Quadrants documentation.
#
# `make html` produces a unified website in $(HTMLDIR) that combines:
#   - the Haxe API reference generated by Dox, and
#   - the Markdown guides under $(GUIDESDIR), folded in by quadrants-dox.
#
# The landing page (index.html) is rendered from $(GUIDESDIR)/index.md; Dox's
# toplevel package listing is moved to api.html.

HAXE ?= haxe
HL ?= hl
# quadrants-dox is the HashLink-running Dox fork (supersedes upstream `haxelib run dox`).
# Resolve its install root from the haxelib classpath and invoke its prebuilt run.hl with `hl`.
QDOX_DIR := $(shell haxelib path quadrants-dox 2>/dev/null | head -1 | xargs dirname 2>/dev/null)
QDOX ?= $(HL) $(QDOX_DIR)/run.hl
BUILDDIR ?= build
XMLDIR := $(BUILDDIR)/xml
HTMLDIR := $(BUILDDIR)/html
XMLFILE := $(XMLDIR)/quadrants.xml
GUIDESDIR := source

DOX_TITLE ?= Quadrants Haxe API
DOX_DESCRIPTION ?= Haxe/HashLink bindings for the Quadrants programming language.
DOX_INCLUDE ?= ^quadrants
DOX_EXCLUDE ?= ^quadrants\.macro
DOXOPTS ?=

# Pull the haxelib version for the docs footer.
HAXELIB_JSON := ../bindings/hashlink/haxelib.json
DOX_VERSION := $(shell sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' $(HAXELIB_JSON) 2>/dev/null)
DOX_WEBSITE ?= https://github.com/yolkarian/quadrants-hl

.PHONY: help html xml clean

help:
	@echo "Quadrants documentation targets:"
	@echo "  make html   Generate the unified Haxe API + Markdown guide site in $(HTMLDIR)"
	@echo "  make xml    Generate Haxe XML docs in $(XMLDIR)"
	@echo "  make clean  Remove $(BUILDDIR)"

html: xml
	@rm -rf "$(HTMLDIR)"
	@$(QDOX) -i "$(XMLDIR)" -o "$(HTMLDIR)" --title "$(DOX_TITLE)" --toplevel-package quadrants -in "$(DOX_INCLUDE)" -ex "$(DOX_EXCLUDE)" -D description "$(DOX_DESCRIPTION)" -D version "$(DOX_VERSION)" -D website "$(DOX_WEBSITE)" --guides "$(GUIDESDIR)" $(DOXOPTS)

xml: $(XMLFILE)

$(XMLFILE): dox.hxml ../bindings/hashlink/haxe/quadrants/*.hx ../bindings/hashlink/haxe/quadrants/macro/*.hx $(wildcard $(GUIDESDIR)/*.md $(GUIDESDIR)/**/*.md)
	@mkdir -p "$(XMLDIR)"
	@$(HAXE) dox.hxml

clean:
	@rm -rf "$(BUILDDIR)"